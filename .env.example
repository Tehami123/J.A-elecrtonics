# Optional if using the default local MongoDB replica set URI below.
MONGODB_URI=mongodb://127.0.0.1:27017/ja-electronics?replicaSet=rs0
# Recommended for deployments: set a unique, shared random secret (32+ chars).
# If unset, the server generates an ephemeral secret; restarting signs users out.
# SESSION_SECRET=
POS_FLAT_DISCOUNT_THRESHOLD=0
